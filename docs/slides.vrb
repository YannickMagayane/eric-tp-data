\frametitle{8. Guide des Commandes Exactes (D\'eploiement, Pipelines et Tests)}
\begin{columns}[T]
        \begin{column}{0.48\textwidth}
            \begin{block}{Infrastructure Docker \& PostgreSQL}
\scriptsize
\begin{verbatim}
./bin/launch.sh          # Build + Up + Validate
docker compose ps        # Etat et healthchecks
docker compose logs -f   # Logs temps reel
docker compose exec dev bash
make load-db             # Charge PostgreSQL 16
docker compose down      # Arret (volumes gardes)
\end{verbatim}
            \end{block}
        \end{column}
        \begin{column}{0.48\textwidth}
            \begin{exampleblock}{Pipelines, Rapports, Tests \& Sauvegarde}
\scriptsize
\begin{verbatim}
make generate-data       # Jeu conforme examen
make pipeline            # UNIX ETL + Audit iragi
make charts && make report
make pdf && make slides  # Rapports LaTeX
./bin/test.sh            # 17 tests + ShellCheck
./bin/backup.sh          # Dump SQL + tar SHA-256
\end{verbatim}
            \end{exampleblock}
        \end{column}
    \end{columns}
